# Encoder ROI windows — regions of the 7680x2160 main stream that get a QP bias.
#
# Copy to /mnt/sda/soccercam/roi.conf on the camera. S37_RoiQp re-reads it
# within 30 s of any change; no reboot and no reflash. The file baked into the
# pak at /etc/soccercam_roi.conf.default is used when roi.conf is absent.
#
# Format: one "key=value" per line, '#' comments, blank lines OK. ANY malformed
# line, unknown key, missing key or out-of-range value rejects the WHOLE file —
# the encoder is left at (or returned to) stock behaviour. Nothing is partially
# applied, and /mnt/sda/soccercam/roi.log says which line was wrong.
#
# What is known from the camera (docs/ENCODER_ROI_QP.md, EXP-ENC-08/09):
#   - Coordinates are PIXELS of the main stream.
#   - A negative qp (mode 1) means more detail inside the window. The stream's
#     bitrate does not change: the rate controller raises the QP everywhere
#     else to pay for it. A window over most of the picture therefore buys
#     almost nothing; a window over the part that matters buys a lot.
#   - Where two windows overlap, the LOWER index wins. Put the most specific
#     window (the far band) on the lowest index.
#   - /proc/hdal/venc/info never lists these windows. roi.log is the readback:
#     it records the kernel's own echo of every write.
#
# ---------------------------------------------------------------------------
# enable   0 = no ROI (stock bit allocation), 1 = apply the windows below
# path     encode path index. 0 = the main stream (7680x2160 H.265).
# mode     0..3. Mode 1 = qp is a DELTA (-32..31) — the only mode tested.
#          Mode 3 makes qp an ABSOLUTE QP (0..51). 0 and 2 are undocumented.
# frame_w  frame size used for the "window must fit inside the frame" check.
# frame_h  Defaults 7680x2160; change only if the stream geometry changes.
#
# Windows, either form but not both in one file:
#
#   winN=x,y,w,h,qp     N = 0..9, one line per window. More than window 0
#                       needs the ten-window firmware (build 4923 or later);
#                       on anything else the file is rejected.
#
#   x= y= w= h= qp=     the original one-window form; it is window 0. Works on
#                       every ROI build, and is what fieldroi writes.
# ---------------------------------------------------------------------------
#
# The example: a far band at -10 on the lowest index, then the rest of the
# pitch in two bands with a weaker bias, on the Spencerport framing (pitch
# roughly y=760..1660). The numbers are a starting point, not a tuned result:
# no multi-window layout has been measured on a real game yet. Re-measure the
# rows per field — the camera is aimed differently at each one.

enable=1
path=0
mode=1
frame_w=7680
frame_h=2160
win0=0,704,7680,256,-10
win1=0,960,7680,320,-6
win2=0,1280,7680,384,-3
